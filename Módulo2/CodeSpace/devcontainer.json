{
  "name": "Curso Bases de Datos",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },

  "postCreateCommand": "pip install --upgrade pip && pip install psycopg[binary]",

  "forwardPorts": [5433],

  "portsAttributes": {
    "5433": {
      "label": "PostgreSQL",
      "protocol": "tcp"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  }
}